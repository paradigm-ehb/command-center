<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="paradigm_ehb.CommandCenter.WinUI.srvMgnt.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:paradigm_ehb.CommandCenter.WinUI.srvMgnt.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid Padding="8" x:Name="GridRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar with refresh -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Padding="20,0,8,8" Grid.Row="0">
            <TextBox x:Name="FilterByName" Width="150" Header="Name"
	            HorizontalAlignment="Left" TextChanged="OnFilterChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8" Grid.Row="0">
            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,4,0"
                    Padding="12,6"/>
        </StackPanel>

        <ListView
            ItemsSource="{x:Bind processes, Mode=OneWay}"
            SelectionMode="Single"
            ShowsScrollingPlaceholders="True"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProcessInfo">
                    <Grid>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Start" Click="ProcessStartMenuItem_Click" />
                                <MenuFlyoutItem Text="Kill" Click="ProcessKillMenuItem_Click" />
                                <MenuFlyoutItem Text="Restart" Click="ProcessRestartMenuItem_Click" />
                                <MenuFlyoutItem Text="View Properties" Click="ProcessViewMenuItem_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Ellipse Width="16" Height="16" Fill="{x:Bind Fill, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                        <!-- Main info -->
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,8,0,0">
                                <TextBlock Text="{x:Bind ProcessName}" Style="{ThemeResource BodyLargeTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Uptime, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="PID:" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ProcessId}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="State:" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind State, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Threads:" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind NumThreads, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>

                        <!-- Action buttons -->
                        <DropDownButton Content="Actions" Grid.Column="2" VerticalAlignment="Center">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Start" Click="ProcessStartMenuItem_Click" />
                                    <MenuFlyoutItem Text="Kill" Click="ProcessKillMenuItem_Click" />
                                    <MenuFlyoutItem Text="Restart" Click="ProcessRestartMenuItem_Click" />
                                    <MenuFlyoutItem Text="View Properties" Click="ProcessViewMenuItem_Click" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
