<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="paradigm_ehb.CommandCenter.WinUI.srvMgnt.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:paradigm_ehb.CommandCenter.WinUI.srvMgnt.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid x:Name="GridRoot" Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- Toolbar with refresh -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8" Padding="20,0,8,8" Grid.Row="0">
            <TextBox x:Name="FilterByName" Width="150" Header="Name"
	            HorizontalAlignment="Left" TextChanged="OnFilterChanged"/>
            <ComboBox
                x:Name="OrderByCombo"
                SelectedValuePath="Tag"
                SelectionChanged="OnOrderChanged"
                VerticalAlignment="Bottom"
                >
                <ComboBoxItem Tag="Default" IsSelected="True">Default</ComboBoxItem>
                <ComboBoxItem Tag="Name">Name</ComboBoxItem>
                <ComboBoxItem Tag="State">State</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8" Grid.Row="0">
            <Button x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="0,0,4,0">
                <SymbolIcon Symbol="Refresh"/>
            </Button>
        </StackPanel>

        <ProgressRing x:Name="LoadingProgressRing" Grid.Row="1" IsActive="True" Width="48" Height="48"/>

        <ListView
            ItemsSource="{x:Bind services, Mode=OneWay}"
            SelectionMode="Single"
            ShowsScrollingPlaceholders="True"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Grid.Row="1">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- Make each item tall enough for two lines of content -->
                    <Setter Property="MinHeight" Value="72" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ServiceInfo">
                    <Grid DoubleTapped="ServiceItem_DoubleTapped" Padding="12" ColumnSpacing="12">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Start Service" Click="ServiceStartMenuItem_Click" />
                                <MenuFlyoutItem Text="Stop Service" Click="ServiceStopMenuItem_Click" />
                                <MenuFlyoutItem Text="Restart Service" Click="ServiceRestartMenuItem_Click" />
                                <MenuFlyoutItem Text="Enable Service" Click="ServiceEnableMenuItem_Click" />
                                <MenuFlyoutItem Text="Disable Service" Click="ServiceDisableMenuItem_Click" />
                                <MenuFlyoutItem Text="View Properties" Click="ServiceViewMenuItem_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Main content: two rows only (first line: Name + state chips; second line: Description) -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- First row: Title/Name on the left, chips on the right -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" Style="{ThemeResource BodyLargeTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Border Background="{x:Bind StateFill, Mode=OneWay}" CornerRadius="12" Padding="8,2" MinWidth="72" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind State, Mode=OneWay}" Foreground="White" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{x:Bind ActiveStateFill, Mode=OneWay}" CornerRadius="12" Padding="8,2" MinWidth="72" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind ActiveState, Mode=OneWay}" Foreground="White" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Second row: description single-line -->
                            <TextBlock Grid.Row="1" Text="{x:Bind Description, Mode=OneWay}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        </Grid>

                        <!-- Actions button on the right -->
                        <DropDownButton Content="Actions" Grid.Column="1" VerticalAlignment="Center">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="Start" Click="ServiceStartMenuItem_Click" Padding="12,8"/>
                                    <MenuFlyoutItem Text="Stop" Click="ServiceStopMenuItem_Click" Padding="12,8"/>
                                    <MenuFlyoutItem Text="Restart" Click="ServiceRestartMenuItem_Click" Padding="12,8"/>
                                    <MenuFlyoutItem Text="Enable" Click="ServiceEnableMenuItem_Click" Padding="12,8"/>
                                    <MenuFlyoutItem Text="Disable" Click="ServiceDisableMenuItem_Click" Padding="12,8"/>
                                    <MenuFlyoutItem Text="View" Click="ServiceViewMenuItem_Click" Padding="12,8"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
