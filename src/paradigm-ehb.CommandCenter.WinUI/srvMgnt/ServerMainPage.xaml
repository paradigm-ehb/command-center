<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="paradigm_ehb.CommandCenter.WinUI.srvMgnt.ServerMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:paradigm_ehb.CommandCenter.WinUI.srvMgnt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Vertical" Margin="25, 15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="serverName"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       FontSize="24" FontWeight="Bold"/>

                    <TextBlock x:Name="serverIP"
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top"
                        FontSize="16" FontWeight="Light"/>
                </StackPanel>


                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                    <Button Click="Edit_Click" Background="Red" Grid.Column="2" Content="Delete" />
                    <Button Click="Edit_Click" Grid.Column="2" Content="Edit" />
                </StackPanel>
            </Grid>

            <SelectorBar SelectionChanged="SelectorBar_SelectionChanged" Margin="-10, -8" x:Name="SelectorBar">
                <SelectorBarItem x:Name="SelectorBarItemOverview" 
                     Text="Overview" Icon="Clock">
                </SelectorBarItem>
                <SelectorBarItem x:Name="SelectorBarItemServices" 
                     Text="Services" Icon="Share"/>
                <SelectorBarItem x:Name="SelectorBarItemProcesses" 
                     Text="Processes" Icon="Favorite"/>
            </SelectorBar>

        </StackPanel>

        <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
    </Grid>
</Page>
