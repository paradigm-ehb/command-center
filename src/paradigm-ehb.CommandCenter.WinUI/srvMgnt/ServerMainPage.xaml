<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="paradigm_ehb.CommandCenter.WinUI.srvMgnt.ServerMainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:paradigm_ehb.CommandCenter.WinUI.srvMgnt"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Margin="25, 15" Grid.Row="0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="serverName"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top"
                       FontSize="24" FontWeight="Bold"/>

                    <TextBlock x:Name="serverIP"
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top"
                        FontSize="16" FontWeight="Light"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Edit" />
            </Grid>

            <SelectorBar SelectionChanged="SelectorBar_SelectionChanged" Margin="-10, -8" x:Name="SelectorBar">
                <SelectorBarItem x:Name="SelectorBarItemRecent" 
                     Text="Overview" Icon="Clock">
                </SelectorBarItem>
                <SelectorBarItem x:Name="SelectorBarItemShared" 
                     Text="Services" Icon="Share"/>
                <SelectorBarItem x:Name="SelectorBarItemFavorites" 
                     Text="Processes" Icon="Favorite"/>
            </SelectorBar>
        </StackPanel>

        <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" Grid.Row="1" />
    </Grid>
</Page>
